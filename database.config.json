{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('DATABASE_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/rest"
    },
    "graphql": {
      "enabled": true,
      "path": "/graphql",
      "allow-introspection": true
    },
    "host": {
      "cors": {
        "origins": ["*"],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "StaticWebApps"
      }
    }
  },
  "entities": {
    "Equipamento": {
      "source": {
        "object": "dbo.Equipamento",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Equipamento",
          "plural": "Equipamentos"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/Equipamento"
      },
      "permissions": [
        {
          "role": "authenticated",
          "actions": [
            {
              "action": "create"
            },
            {
              "action": "read"
            },
            {
              "action": "update"
            },
            {
              "action": "delete"
            }
          ]
        }
      ]
    },
    "Users": {
      "source": {
        "object": "dbo.Users",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "User",
          "plural": "Users"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/Users"
      },
      "permissions": [
        {
          "role": "authenticated",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "ClientRecord": {
      "source": {
        "object": "dbo.ClientRecord",
        "type": "table"
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "ClientRecord",
          "plural": "ClientRecords"
        }
      },
      "rest": {
        "enabled": true,
        "path": "/ClientRecord"
      },
      "permissions": [
        {
          "role": "authenticated",
          "actions": [
            {
              "action": "create"
            },
            {
              "action": "read"
            },
            {
              "action": "update"
            }
          ]
        }
      ]
    }
  }
}