# Azure SQL Database Connection String for DAB (Data Access Builder)
# Format: Standard SQL Server connection string (NOT SQLAlchemy format)
DATABASE_CONNECTION_STRING=Server=tcp:smartspaar.database.windows.net,1433;Initial Catalog=master;Persist Security Info=False;User ID=Administrador;Password=*A2DCi22;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Alternative formats (choose ONE):

# 1. With Azure AD Authentication (recommended for production):
# DATABASE_CONNECTION_STRING=Server=smartspaaroperation.database.windows.net,1433;Database=YOUR_DATABASE_NAME;Authentication=Active Directory Default;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;

# 2. With connection pooling optimizations:
# DATABASE_CONNECTION_STRING=Server=smartspaaroperation.database.windows.net,1433;Database=YOUR_DATABASE_NAME;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;Connection Timeout=30;Max Pool Size=100;Min Pool Size=5;

# 3. Local SQL Server (for development):
# DATABASE_CONNECTION_STRING=Server=localhost;Database=YOUR_DATABASE_NAME;Integrated Security=true;TrustServerCertificate=true;

# IMPORTANT: 
# - Replace YOUR_DATABASE_NAME, YOUR_USERNAME, YOUR_PASSWORD with actual values
# - Never commit actual credentials to version control
# - Use Azure Key Vault or GitHub Secrets for production deployments