# Environment Variables for SmartSpaar Azure Static Web App

# Azure SQL Database Connection String
# Replace the placeholders with actual values for smartspaar.database.windows.net
# DATABASE_CONNECTION_STRING="Server=smartspaar.database.windows.net;Database=main;User ID=<username>;Password=<password>;Trusted_Connection=False;Connection Timeout=30;Encrypt=True;"

# Example connection string format:
# DATABASE_CONNECTION_STRING="Server=smartspaar.database.windows.net;Database=main;User ID=smartspaar_admin;Password=YourSecurePassword123!;Trusted_Connection=False;Connection Timeout=30;Encrypt=True;"

# This file should be configured in Azure Static Web Apps environment variables
# Do not commit actual credentials to the repository