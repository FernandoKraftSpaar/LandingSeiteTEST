{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "options": {
      "set-session-context": false 
    },
    "connection-string": "@env('DATABASE_CONNECTION_STRING')"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/rest",
      "request-body-strict": false
    },
    "graphql": {
      "allow-introspection": true,
      "enabled": true,
      "path": "/graphql"
    },
    "host": {
      "mode": "production",
      "cors": {
        "origins": [
          "https://www.smartspaar.com.br",
          "https://jolly-tree-034e7b00f.5.azurestaticapps.net",
          "http://localhost:3000",
          "http://localhost:4280"
        ],
        "allow-credentials": true
      },
      "authentication": {
        "provider": "StaticWebApps"
      }
    }
  },
  "entities": {
    "Equipamento": {
      "source": {
        "object": "dbo.equipamentos",
        "type": "table"
      },
      "permissions": [

        {
          "actions": ["read","create", "update", "delete"],
          "role": "authenticated"
        }
      ],
      "mappings": {
        "id": "id",
        "nome": "nome", 
        "potencia": "potencia",
        "horas_uso": "horas_uso",
        "categoria": "categoria",
        "idade": "idade",
        "etiqueta_eficiencia": "etiqueta_eficiencia",
        "observacoes": "observacoes",
        "tag": "tag",
        "fator_correcao": "fator_correcao",
        "op_hora_ini": "op_hora_ini",
        "op_hora_fim": "op_hora_fim",
        "connected_to": "connected_to",
        "created_at": "created_at",
        "updated_at": "updated_at"
      }
    }
  }
}
