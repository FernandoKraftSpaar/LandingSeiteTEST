{
  "routes": [
    {
      "route": "/login",
      "allowedRoles": ["anonymous"],
      "rewrite": "/login.html"
    },
    {
      "route": "/dashboard",
      "allowedRoles": ["authenticated"],
      "rewrite": "/dashboard/index.html"
    },
    {
      "route": "/dashboard/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/perfil",
      "allowedRoles": ["authenticated"],
      "rewrite": "/perfil.html"
    },
    {
      "route": "/",
      "allowedRoles": ["anonymous"],
      "rewrite": "/index.html"
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "authentication": {
    "login": {
      "loginPath": "/login"
    }
  }
}